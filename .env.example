# Any OpenAI-compatible chat endpoint. Leave OPENAI_API_KEY empty to run in extractive mode (no LLM).
OPENAI_API_KEY=
# OpenAI: leave the base URL empty, model e.g. gpt-4o-mini
# Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  OPENAI_MODEL=gemini-2.5-flash
# Groq:   OPENAI_BASE_URL=https://api.groq.com/openai/v1                             OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Optional, for reasoning models (e.g. low)
OPENAI_REASONING_EFFORT=
# Similarity floor for the relevance gate (bge-small cosine)
RELEVANCE_FLOOR=0.55
# Questions per visitor per 10 minutes
RATE_LIMIT=30
