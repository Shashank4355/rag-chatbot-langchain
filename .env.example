# Option A (default for the demo): Google AI Studio free tier.
# Models are tried in order; a 429 or quota error moves to the next one at once.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-3.1-flash-lite
# GEMINI_REASONING_EFFORT=low

# Option B: any OpenAI-compatible endpoint (takes precedence when set). Comma-separate models for fallbacks.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# No key at all: extractive answers (sentences picked from the retrieved excerpts).

# Model calls per instance per UTC day before falling back to extractive answers
DAILY_LLM_CAP=400
# Questions per visitor per 10 minutes
RATE_LIMIT=30
# Similarity floor for the relevance gate (bge-small cosine)
RELEVANCE_FLOOR=0.55
